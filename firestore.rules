rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's own profile document (contains role + businessId,
    // and for owners with more than one shop, businessIds[] + activeBusinessId).
    // Used by nearly every rule below to establish membership/ownership.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // An owner's shop list. Owners created before multi-shop support only
    // ever have the legacy singular `businessId` — this never defaults to
    // that here (unlike the client's derived fallback) because rules must
    // check the field that's actually on the document; `isMemberOf` below
    // checks `businessId` directly as a separate, always-present clause.
    function ownedBusinessIds() {
      return myProfile().get('businessIds', []);
    }

    // Set exclusively by the server (server/index.ts, via the Admin SDK,
    // which bypasses these rules entirely) — never writable by the client
    // (see the users/{userId} update rule below). Checking it here means a
    // suspended staff member is denied at the data layer the instant this
    // field flips, rather than only once their Firebase Auth ID token
    // naturally expires.
    function isSuspended() {
      return myProfile().get('suspended', false) == true;
    }

    function isMemberOf(businessId) {
      return isSignedIn() && !isSuspended() && (
        myProfile().businessId == businessId ||
        businessId in ownedBusinessIds()
      );
    }

    function isOwnerOf(businessId) {
      return isMemberOf(businessId) && myProfile().role == 'owner';
    }

    // ==========================================================
    // /users/{userId} - one profile doc per authenticated user
    // ==========================================================
    match /users/{userId} {
      // A user can always read their own profile. An owner can also read the
      // profiles of staff that belong to any of their own shops (e.g. staff
      // list) — checked against the legacy single businessId (covers staff
      // of the owner's original shop) and the full businessIds list (covers
      // staff of any additional shops added via addShop).
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          myProfile().role == 'owner' &&
          (myProfile().businessId == resource.data.businessId || resource.data.businessId in ownedBusinessIds())
        )
      );

      // Creating a profile happens in two flows:
      //  1) Self-registration - a brand new owner creating their own profile.
      //  2) An owner provisioning a staff account (created via a secondary
      //     Firebase Auth app, then written here under the owner's session).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'owner') ||
        (
          request.auth.uid != userId &&
          request.resource.data.role == 'staff' &&
          isOwnerOf(request.resource.data.businessId)
        )
      );

      // A user may only update their own profile, and may never change their
      // own role, legacy business, or suspension status (each would be a
      // privilege-escalation path — suspended in particular must only ever
      // be flipped by the server via suspendStaffMember/reactivateStaffMember,
      // which use the Admin SDK and bypass these rules; otherwise a suspended
      // staff member could simply un-suspend themselves with a plain write).
      // businessIds may only ever grow by exactly one entry per write,
      // and only if that new entry is a /businesses/{id} doc this uid
      // actually owns (checked server-side here, not just trusted from the
      // client) — otherwise anyone could hand themselves read/write access
      // to someone else's shop just by editing their own array. The 10-shop
      // cap is enforced here too, as a backstop to the client-side check.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
        isValidBusinessIdsChange() &&
        isValidActiveBusinessIdChange();

      function isValidBusinessIdsChange() {
        let oldIds = resource.data.get('businessIds', []);
        let newIds = request.resource.data.get('businessIds', []);
        return newIds == oldIds || (
          resource.data.role == 'owner' &&
          oldIds.size() < 10 &&
          newIds == oldIds.concat([newIds[newIds.size() - 1]]) &&
          get(/databases/$(database)/documents/businesses/$(newIds[newIds.size() - 1])).data.ownerUid == request.auth.uid
        );
      }

      function isValidActiveBusinessIdChange() {
        let newActive = request.resource.data.get('activeBusinessId', null);
        let newIds = request.resource.data.get('businessIds', []);
        return newActive == null || newActive in newIds;
      }

      // A user can delete their own profile. Owner-initiated removal of a
      // STAFF member's profile must go through the deleteStaffMember Cloud
      // Function (Admin SDK, bypasses these rules) — never directly from
      // the client — because that function also deletes the corresponding
      // Firebase Authentication account. A client-side delete here alone
      // would silently leave an orphaned Auth account behind.
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================================
    // /businesses/{businessId}
    // ==========================================================
    match /businesses/{businessId} {
      allow read: if isMemberOf(businessId);

      // A business is only ever created by its own owner (uid matches the
      // ownerUid on the new document), and the id doesn't exist yet.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;

      // Only the owner can change business settings (currency, category, name).
      allow update: if isOwnerOf(businessId);
      allow delete: if false;

      // ----------------------------------------------------------
      // Operational data any team member (owner or staff) can read
      // and create, but only the owner can edit/delete.
      // ----------------------------------------------------------
      match /products/{productId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update, delete: if isOwnerOf(businessId);
      }

      match /batches/{batchId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        // Batches are also updated by staff/owner alike when a new batch
        // closes out the previous open one (addStockBatch / addMultipleStockBatches).
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      // Purchase Batches (Investment Ledger) — the envelope grouping one or
      // more /batches line items into a single purchase/investment event.
      // Same access pattern as /batches: any team member can read/create,
      // any team member can update (archiving/unarchiving), only the owner
      // can delete.
      match /purchaseBatches/{purchaseBatchId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      match /quebras/{quebraId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      match /expenses/{expenseId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      // Stock Counts (Initial Capital baseline + periodic physical counts).
      // These establish/verify business capital, so only the owner may
      // record or remove them; any team member may read them.
      match /stockCounts/{stockCountId} {
        allow read: if isMemberOf(businessId);
        allow create: if isOwnerOf(businessId);
        allow update, delete: if isOwnerOf(businessId);
      }

      // Owner Withdrawals: money taken by the owner personally. Only the
      // owner may record/edit/remove these — staff never handle this.
      match /withdrawals/{withdrawalId} {
        allow read, create, update, delete: if isOwnerOf(businessId);
      }

      // Monthly/Yearly Closings: permanently lock a period's figures. Only
      // the owner may record or remove these — staff never handle this.
      match /closings/{closingId} {
        allow read, create, update, delete: if isOwnerOf(businessId);
      }

      // Staff roster management is owner-only. Deletion is intentionally
      // NOT allowed from the client (allow delete: if false) — removing a
      // staff member must go through the deleteStaffMember Cloud Function
      // so their Firebase Authentication account is deleted in the same
      // operation, never leaving an orphaned login behind.
      match /staff/{staffId} {
        allow read, create, update: if isOwnerOf(businessId);
        allow delete: if false;
      }

      // Business Timeline: an append-only history log written alongside the
      // actions above (e.g. a staff member adding stock also writes the
      // matching timeline entry). Any team member can read and create
      // entries; entries are never edited once written — only the owner can
      // remove one (used solely by clearAllData / data reset).
      match /timelineEvents/{timelineEventId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update: if false;
        allow delete: if isOwnerOf(businessId);
      }
    }
  }
}
