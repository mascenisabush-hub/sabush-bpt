rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's own profile document (contains role + businessId,
    // and for owners with more than one shop, businessIds[] + activeBusinessId).
    // Used by nearly every rule below to establish membership/ownership.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // An owner's shop list. Owners created before multi-shop support only
    // ever have the legacy singular `businessId` — this never defaults to
    // that here (unlike the client's derived fallback) because rules must
    // check the field that's actually on the document; `isMemberOf` below
    // checks `businessId` directly as a separate, always-present clause.
    function ownedBusinessIds() {
      return myProfile().get('businessIds', []);
    }

    // Set exclusively by the server (server/index.ts, via the Admin SDK,
    // which bypasses these rules entirely) — never writable by the client
    // (see the users/{userId} update rule below). Checking it here means a
    // suspended staff member is denied at the data layer the instant this
    // field flips, rather than only once their Firebase Auth ID token
    // naturally expires.
    function isSuspended() {
      return myProfile().get('suspended', false) == true;
    }

    function isMemberOf(businessId) {
      return isSignedIn() && !isSuspended() && (
        myProfile().businessId == businessId ||
        businessId in ownedBusinessIds()
      );
    }

    // [Phase 0 Stage 1 — owner->admin migration] Accepts both the legacy
    // 'owner' value and the target 'admin' value so existing accounts
    // keep working unchanged while new/backfilled accounts can use either
    // value. This tolerance is intentionally temporary — see
    // docs/engineering/phase0-owner-admin-migration-implementation-plan.md.
    function isOwnerOf(businessId) {
      return isMemberOf(businessId) && (myProfile().role == 'owner' || myProfile().role == 'admin');
    }

    // BDS #16 (Staff & Roles) / Architecture 6.3 amendment. Manager is not
    // a new role — it's a permission-tier field on the same staff account.
    // Passes if the caller is the Admin (unchanged from isOwnerOf), OR the
    // caller is a Staff account promoted to 'manager', scoped to this exact
    // businessId (a Manager never has multi-shop reach, same as any Staff),
    // AND has been explicitly granted this specific permission — staffTier
    // alone grants nothing. staffTier/managerPermissions are themselves
    // writable only by the privileged server (server/index.ts), never by
    // the client, same guarantee as `suspended`.
    function isOwnerOrGrantedManager(businessId, permission) {
      return isOwnerOf(businessId) || (
        isMemberOf(businessId) &&
        myProfile().role == 'staff' &&
        myProfile().get('staffTier', 'staff') == 'manager' &&
        myProfile().businessId == businessId &&
        myProfile().get('managerPermissions', {}).get(permission, false) == true
      );
    }

    // [Module #20 Phase 1 (Foundations), Checkpoint 2] `notifications` is
    // this repository's first top-level (not business-nested) collection
    // — recipient scoping (spec 20.1/20.2) is expressed via document
    // fields (`scope`/`businessId`/`userId`) rather than a path segment,
    // unlike every isMemberOf/isOwnerOf use above. Mirrors the
    // /subscriptions read-scope shape below (Owner/Admin full access,
    // Manager-tier view-only, no specific granted permission required —
    // 20.2's "same 'view only' boundary already established for
    // Subscription visibility") re-expressed for a field-scoped, not
    // path-scoped, document.
    //
    // Suspension check: isMemberOf()/isOwnerOf() already fold in
    // !isSuspended() for the Business-scoped branch. For the User-scoped
    // branch this function applies the same platform-wide suspension cut
    // (see the "suspended member" test elsewhere in this repo's test
    // suite) rather than carving out an exception for a user's own
    // notifications — consistent existing behavior, not a new rule.
    function isNotificationRecipient(resource) {
      return resource.data.scope == 'business'
        ? (
            isOwnerOf(resource.data.businessId) || (
              isMemberOf(resource.data.businessId) &&
              myProfile().get('staffTier', 'staff') == 'manager'
            )
          )
        : (
            resource.data.scope == 'user' &&
            isSignedIn() && !isSuspended() &&
            resource.data.userId == request.auth.uid
          );
    }

    // [Closing Integrity Amendment v1.0] A rule cannot run a range query
    // ("does any Closing cover this date?") — it can only get() a document
    // at a known path. ClosedPeriod docs exist purely so this becomes a
    // deterministic lookup: split the incoming date "YYYY-MM-DD" and check
    // both possible period keys (monthly and yearly) for that business.
    // Must derive the exact same id shape as closedPeriodKey() in
    // AppContext.tsx — if that function ever changes, this must too.
    function isDateInsideClosedPeriod(businessId, dateStr) {
      let parts = dateStr.split('-');
      let year = parts[0];
      let month = parts[1];
      return exists(/databases/$(database)/documents/businesses/$(businessId)/closedPeriods/$('monthly:' + year + '-' + month)) ||
             exists(/databases/$(database)/documents/businesses/$(businessId)/closedPeriods/$('yearly:' + year));
    }

    // [Module #19 Phase 2 — Trial Engine] Restricted-Operations
    // Enforcement (Business Rule 6 / Phase 2 Decision 2, principle-based:
    // "operations that create, modify, or delete records affecting
    // Business Worth or financial position become unavailable after
    // trial completion unless an appropriate subscription state is
    // restored"). Applied to `create` only in this pass — the spec's own
    // Restricted-Operations Enforcement language is specifically about
    // "new operational record creation," and scoping to create keeps
    // this change reviewable without touching the already-battle-tested
    // closingId-based update/delete logic on Expenses/Withdrawals below.
    // Broadening to update/delete is a disclosed, deliberate follow-up
    // decision, not silently out of scope — see the Phase 2 report.
    //
    // hasSubscription()/subscriptionAllowsNewRecords() together fail
    // OPEN (permit the write) when no subscriptions/{businessId} document
    // exists at all. This is a deliberate, explicitly-flagged INTERIM
    // behavior: every Business created since Phase 1 (commit 4d9d34b)
    // always has one, but Businesses that predate Phase 1 do not yet —
    // the legacy migration that gives every existing Business an
    // explicit subscription record (spec's "Explicitly Left Open," item
    // 6) has not been built. Business Rule 4 ("no null subscription
    // states, ever") means this fail-open is accepted as temporary, not
    // permanent — it must not be read as "missing means unrestricted
    // forever." Denying instead (fail-closed) was rejected here because
    // it would lock every real, currently-operating pre-Phase-1 tenant
    // out of recording sales/purchases/expenses the moment this rule
    // deployed, with no migration having run yet to give them a
    // subscription document to be governed by in the first place.
    function hasSubscription(businessId) {
      return exists(/databases/$(database)/documents/subscriptions/$(businessId));
    }

    function subscriptionAllowsNewRecords(businessId) {
      return !hasSubscription(businessId) || (
        get(/databases/$(database)/documents/subscriptions/$(businessId)).data.status != 'trial_completed' &&
        get(/databases/$(database)/documents/subscriptions/$(businessId)).data.status != 'expired'
      );
    }

    // ==========================================================
    // /users/{userId} - one profile doc per authenticated user
    // ==========================================================
    match /users/{userId} {
      // A user can always read their own profile. An owner can also read the
      // profiles of staff that belong to any of their own shops (e.g. staff
      // list) — checked against the legacy single businessId (covers staff
      // of the owner's original shop) and the full businessIds list (covers
      // staff of any additional shops added via addShop).
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          (myProfile().role == 'owner' || myProfile().role == 'admin') &&
          (myProfile().businessId == resource.data.businessId || resource.data.businessId in ownedBusinessIds())
        )
      );

      // Creating a profile happens in two flows:
      //  1) Self-registration - a brand new owner creating their own profile.
      //  2) An owner (or a Staff account granted the 'staffManagement'
      //     Manager permission, BDS #16) provisioning a staff account
      //     (created via a secondary Firebase Auth app, then written here
      //     under the creator's session). A Manager can only ever create a
      //     plain 'staff' profile here — never one with staffTier set to
      //     'manager' — promoting to Manager is a separate, Admin-only
      //     action (see the update rule below).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (request.resource.data.role == 'owner' || request.resource.data.role == 'admin')) ||
        (
          request.auth.uid != userId &&
          request.resource.data.role == 'staff' &&
          request.resource.data.get('staffTier', 'staff') == 'staff' &&
          isOwnerOrGrantedManager(request.resource.data.businessId, 'staffManagement')
        )
      );

      // A user may only update their own profile, and may never change their
      // own role, legacy business, or suspension status (each would be a
      // privilege-escalation path — suspended in particular must only ever
      // be flipped by the server via suspendStaffMember/reactivateStaffMember,
      // which use the Admin SDK and bypass these rules; otherwise a suspended
      // staff member could simply un-suspend themselves with a plain write).
      // staffTier and managerPermissions (BDS #16) get the identical
      // guarantee — set only by the server's set-tier endpoint, never by a
      // plain client write, otherwise a staff member could self-grant
      // Manager tier and every permission it unlocks in one write.
      // businessIds may only ever grow by exactly one entry per write,
      // and only if that new entry is a /businesses/{id} doc this uid
      // actually owns (checked server-side here, not just trusted from the
      // client) — otherwise anyone could hand themselves read/write access
      // to someone else's shop just by editing their own array. The 10-shop
      // cap is enforced here too, as a backstop to the client-side check.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
        request.resource.data.get('staffTier', 'staff') == resource.data.get('staffTier', 'staff') &&
        request.resource.data.get('managerPermissions', {}) == resource.data.get('managerPermissions', {}) &&
        isValidBusinessIdsChange() &&
        isValidActiveBusinessIdChange();

      function isValidBusinessIdsChange() {
        let oldIds = resource.data.get('businessIds', []);
        let newIds = request.resource.data.get('businessIds', []);
        return newIds == oldIds || (
          (resource.data.role == 'owner' || resource.data.role == 'admin') &&
          oldIds.size() < 10 &&
          newIds == oldIds.concat([newIds[newIds.size() - 1]]) &&
          get(/databases/$(database)/documents/businesses/$(newIds[newIds.size() - 1])).data.ownerUid == request.auth.uid
        );
      }

      function isValidActiveBusinessIdChange() {
        let newActive = request.resource.data.get('activeBusinessId', null);
        let newIds = request.resource.data.get('businessIds', []);
        return newActive == null || newActive in newIds;
      }

      // A user can delete their own profile. Owner-initiated removal of a
      // STAFF member's profile must go through the deleteStaffMember Cloud
      // Function (Admin SDK, bypasses these rules) — never directly from
      // the client — because that function also deletes the corresponding
      // Firebase Authentication account. A client-side delete here alone
      // would silently leave an orphaned Auth account behind.
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================================
    // /businesses/{businessId}
    // ==========================================================
    match /businesses/{businessId} {
      allow read: if isMemberOf(businessId);

      // A business is only ever created by its own owner (uid matches the
      // ownerUid on the new document), and the id doesn't exist yet.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;

      // Only the owner can change business settings (currency, category, name).
      allow update: if isOwnerOf(businessId);
      allow delete: if false;

      // ----------------------------------------------------------
      // Operational data any team member (owner or staff) can read
      // and create, but only the owner can edit/delete.
      // ----------------------------------------------------------
      match /products/{productId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update, delete: if isOwnerOf(businessId);
      }

      match /batches/{batchId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Stock receipt — restricted once trial
        // completes/expires (Business Rule 6 / Decision 2).
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId);
        // Batches are also updated by staff/owner alike when a new batch
        // closes out the previous open one (addStockBatch / addMultipleStockBatches).
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      // Purchase Batches (Investment Ledger) — the envelope grouping one or
      // more /batches line items into a single purchase/investment event.
      // Same access pattern as /batches: any team member can read/create,
      // any team member can update (archiving/unarchiving), only the owner
      // can delete.
      match /purchaseBatches/{purchaseBatchId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] New purchase — restricted once trial
        // completes/expires (Business Rule 6 / Decision 2). update
        // (archive/unarchive) is left unrestricted — organizing an
        // existing record doesn't create or change Business Worth.
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      match /quebras/{quebraId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Inventory adjustment — restricted once
        // trial completes/expires (Business Rule 6 / Decision 2).
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      // [Closing Integrity Amendment v1.0]
      //  - create: blocked if the entry's own date falls inside an
      //    already-closed period (Half 2 — protects the closed period
      //    itself, not just existing records).
      //  - update/delete: blocked once closingId is set (Half 1 — no
      //    client function currently calls update on an Expense, but the
      //    rule itself must not be laxer than the app, the same class of
      //    gap BDS #10 flagged for Stock Counts).
      match /expenses/{expenseId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Restricted once trial completes/expires
        // (Business Rule 6 / Decision 2), independent of and in addition
        // to the closed-period check already here.
        allow create: if isMemberOf(businessId) &&
          !isDateInsideClosedPeriod(businessId, request.resource.data.date) &&
          subscriptionAllowsNewRecords(businessId);
        allow update: if isMemberOf(businessId) && (
          resource.data.get('closingId', null) == null ||
          (isOwnerOf(businessId) && request.resource.data.get('closingId', null) == null)
        );
        allow delete: if isOwnerOf(businessId) &&
          resource.data.get('closingId', null) == null;
      }

      // Stock Counts (Initial Capital baseline + periodic physical counts).
      // These establish/verify business capital, so only the owner may
      // record or remove them; any team member may read them.
      match /stockCounts/{stockCountId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Establishes/adjusts the capital baseline
        // that Business Worth is measured against — restricted once
        // trial completes/expires (Business Rule 6 / Decision 2).
        allow create: if isOwnerOf(businessId) && subscriptionAllowsNewRecords(businessId);
        allow update, delete: if isOwnerOf(businessId);
      }

      // Owner Withdrawals: money taken by the owner personally. Only the
      // owner may record/edit/remove these — staff never handle this.
      // [Closing Integrity Amendment v1.0] Same create/update/delete
      // protections as Expenses, above — see that comment for the rule.
      match /withdrawals/{withdrawalId} {
        allow read: if isOwnerOf(businessId);
        // [Module #19 Phase 2] Changes financial position directly —
        // restricted once trial completes/expires (Business Rule 6 /
        // Decision 2), same as Expenses above.
        allow create: if isOwnerOf(businessId) &&
          !isDateInsideClosedPeriod(businessId, request.resource.data.date) &&
          subscriptionAllowsNewRecords(businessId);
        allow update: if isOwnerOf(businessId) && (
          resource.data.get('closingId', null) == null ||
          request.resource.data.get('closingId', null) == null
        );
        allow delete: if isOwnerOf(businessId) &&
          resource.data.get('closingId', null) == null;
      }

      // Payments (Module #19 V1 Manual Payment Bridge) — a temporary
      // confirmation bridge, NOT the final payment architecture.
      // Deliberately NOT gated by subscriptionAllowsNewRecords(): this
      // is the one write path that must remain reachable specifically
      // WHILE a subscription is trial_completed/expired — it is the
      // Owner's way out of that state, not another kind of operational
      // record that state is meant to restrict.
      //
      // Only the Owner may submit (never Staff — this mirrors
      // Withdrawals' owner-only access, since subscription payment is
      // an owner-level financial matter). A submission must always
      // start 'pending', with no confirmation fields present — the
      // client can never create an already-confirmed record. Once
      // created, a Payment is immutable from the client's side in
      // every respect: no update, no delete. Only the server-side
      // confirmation mechanism (Admin SDK, bypasses these rules
      // entirely, per Implementation Authorization §5 "server-side
      // only... not callable by an ordinary tenant user") may ever
      // transition it to confirmed/rejected.
      match /payments/{paymentId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.businessId == businessId &&
          request.resource.data.submittedBy == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.currency == 'MZN' &&
          !request.resource.data.keys().hasAny(['confirmedAt', 'confirmedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason']);
        allow update: if false;
        allow delete: if false;
      }

      // Monthly/Yearly Closings: permanently lock a period's figures. The
      // Admin can always do this; a Staff account promoted to Manager can
      // too, but only if explicitly granted the 'closings' permission
      // (BDS #16 / Architecture 6.3) — staffTier === 'manager' alone is
      // not enough. A plain Staff member never handles this, same as today.
      //
      // [Closing Integrity Amendment v1.0 — fixes a real gap found during
      // implementation] Reopening (update, setting status: 'reopened') is
      // deliberately NOT covered by the same Manager grant that covers
      // create — the amendment's Decisions Record is explicit that a
      // Manager who can *record* a Closing is not automatically a Manager
      // who should be able to *un*-close one. Before this amendment, this
      // rule allowed a granted Manager to delete (and thereby reopen) any
      // Closing — that gap is closed here, not just documented. A Closing
      // is also never deleted anymore — reopening supersedes it in place
      // (recordClosing/reopenClosing, AppContext.tsx).
      match /closings/{closingId} {
        allow read, create: if isOwnerOrGrantedManager(businessId, 'closings');
        allow update: if isOwnerOf(businessId);
        allow delete: if false;
      }

      // [Closing Integrity Amendment v1.0] Lock-index docs — see
      // ClosedPeriod in types.ts. Written alongside a Closing (create,
      // same permission), deleted only by an Owner reopening a period
      // (reopenClosing) — never by a Manager, matching the closings rule
      // above. Never updated in place.
      match /closedPeriods/{periodKey} {
        allow read: if isMemberOf(businessId);
        allow create: if isOwnerOrGrantedManager(businessId, 'closings');
        allow update: if false;
        allow delete: if isOwnerOf(businessId);
      }

      // Staff roster management: the Admin can always do this. A Staff
      // account promoted to Manager can too, but only with the
      // 'staffManagement' permission explicitly granted (BDS #16). A
      // Manager can never touch another Manager's or the Admin's record —
      // that guard lives server-side (server/index.ts), since it depends
      // on the *target's* tier, which a rule reading only the caller's
      // profile can't safely evaluate without an extra read per write.
      // Deletion is intentionally NOT allowed from the client for anyone
      // (allow delete: if false) — removing a staff member must go through
      // the deleteStaffMember server endpoint so their Firebase
      // Authentication account is deleted in the same operation, never
      // leaving an orphaned login behind. That endpoint enforces the
      // Admin-or-granted-Manager check itself.
      match /staff/{staffId} {
        allow read, create, update: if isOwnerOrGrantedManager(businessId, 'staffManagement');
        allow delete: if false;
      }

      // Business Timeline: an append-only history log written alongside the
      // actions above (e.g. a staff member adding stock also writes the
      // matching timeline entry). Any team member can read and create
      // entries; entries are never edited once written — only the owner can
      // remove one (used solely by clearAllData / data reset).
      match /timelineEvents/{timelineEventId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update: if false;
        allow delete: if isOwnerOf(businessId);
      }
    }

    // ==========================================================
    // /subscriptions/{subscriptionId} - one doc per Business
    // (subscriptionId === businessId, per docs/specs/19-subscriptions.md
    // "Data Model"). Module #19, Phase 1 (Foundations) + Phase 2
    // (Trial Engine) -- Phase 2 adds two more Admin-SDK-only writers
    // (the activate-trial endpoint and the Trial Lifecycle Worker) but
    // does not change this block's rules: still no client write path.
    //
    // Read scope deliberately narrower than plain isMemberOf(businessId):
    // the spec's Security Considerations section (§616-622) says this
    // document is readable by "that Business's own Admin/Manager (view)"
    // — not by every team member. Regular (non-Manager) Staff has no
    // read access here, unlike most other collections in this file.
    // (Rule 8 Assessment, Module #19 Phase 1, Decision 2 — approved.)
    //
    // Every write (creation by the Business Provisioning Orchestrator,
    // future SuperAdmin overrides, future billing-webhook updates) goes
    // through server/index.ts via the Admin SDK, which bypasses these
    // rules entirely — allow write is unconditionally false here, same
    // guarantee as `suspended`/`staffTier`/`managerPermissions` on
    // /users/{userId}. No client path may ever write a subscription.
    // ==========================================================
    match /subscriptions/{subscriptionId} {
      allow read: if isOwnerOf(subscriptionId) || (
        isMemberOf(subscriptionId) &&
        myProfile().get('staffTier', 'staff') == 'manager'
      );
      allow write: if false;
    }

    // ==========================================================
    // /notifications/{notificationId} — Module #20 Phase 1
    // (Foundations), Checkpoint 2. Top-level collection (spec 20.1) —
    // see isNotificationRecipient() above for why this is field-scoped
    // rather than path-scoped.
    //
    // - read: Business-scoped visible to that Business's Owner/Admin and
    //   Manager-tier staff (view-only, no specific permission required —
    //   20.2); User-scoped visible only to the matching uid. Never a
    //   plain (non-Manager) Staff member for Business-scoped documents.
    // - create: always false. No client ever creates a notification, in
    //   any phase (Decision Gate 2) — only the privileged server, the
    //   Background Worker, or the payment webhook handler, all via the
    //   Admin SDK, which bypasses these rules. No producer exists yet in
    //   Phase 1 regardless (Checkpoint 2 ships only a persistence
    //   helper, unwired to any producer).
    // - update: permitted only as a single-field `status` transition, by
    //   a caller who already satisfies the read condition above. This is
    //   the one client-direct write path this collection has, covering
    //   both the "mark read" and "dismiss" UI actions — POL-20-001
    //   Decision 1 explicitly couples them onto this same field
    //   ("dismissing a notification automatically marks it read"; the
    //   approved data model, 20.1, has no separate dismissal field).
    //   Every other field is immutable after creation (POL-20-001
    //   Decision 4, Notification Immutability) — enforced here by
    //   requiring every field but `status` to be unchanged, the same
    //   field-by-field-equality idiom used by /users/{userId}'s own
    //   update rule above, rather than introducing a new diff()/
    //   affectedKeys() mechanism this file hasn't used before.
    // - delete: always false. No automatic or client-initiated deletion
    //   in V1 (POL-20-001 Decision 3).
    // ==========================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isNotificationRecipient(resource);

      allow create: if false;

      allow update: if isSignedIn() && isNotificationRecipient(resource) &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.payloadRef == resource.data.payloadRef &&
        request.resource.data.channel == resource.data.channel &&
        request.resource.data.dedupeKey == resource.data.dedupeKey &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.context == resource.data.context &&
        request.resource.data.priority == resource.data.priority &&
        // [Priority Reconciliation Amendment, v1.3] `importance` is a
        // new field (20.1) alongside `priority` — POL-20-001 Decision 4
        // (Notification Immutability) already covers "every field but
        // status"; this line keeps that existing guarantee true for the
        // new field rather than leaving it silently unenforced. Not a
        // new client read/write surface — `importance` was never
        // client-writable before this line existed, since `create` is
        // unconditionally false above; this only closes the same
        // immutability net around a field that didn't exist yet when
        // that net was first drawn.
        request.resource.data.importance == resource.data.importance &&
        (request.resource.data.status == 'unread' || request.resource.data.status == 'read');

      allow delete: if false;
    }

    // ==========================================================
    // /platform_audit_log/{eventId} - append-only, system-written only.
    // Module #19 Phase 2 (Trial Engine), Decision 4 — automatic
    // lifecycle transitions (trial activated/completed, and future
    // grace-period/expiry/renewal events) are audited the same way
    // Business Rule 8 already requires for SuperAdmin overrides.
    //
    // Architecture §9.6 scopes read access to platform-operator roles
    // (Support/Developer/SuperAdmin) — but that role model
    // (`platformRole` on a user profile) is Module #18, not yet built.
    // Rather than invent a role check ahead of #18's own design, this
    // collection is entirely client-inaccessible for now: no client
    // read, no client write (every write goes through server/index.ts
    // via the Admin SDK, same guarantee as /subscriptions above). Read
    // access for platform operators is added when #18 builds the actual
    // role model — tracked, not silently deferred.
    // ==========================================================
    match /platform_audit_log/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // ==========================================================
    // /platform_event_dedupe/{dedupeKey} — Module #20 Phase 3
    // Checkpoint 2 (Platform Infrastructure). The dedupe/watermark
    // mechanism Architecture §4.8.1 names (one of its two candidate
    // shapes — see server/notificationPlatform.ts's own comment for
    // the engineering rationale). Records that a producer-owned
    // BusinessEvent dedupeKey has been evaluated (ADR-0004 Decision 2),
    // independent of whether that evaluation produced a notification.
    // Purely internal platform state — never a business fact, never
    // read or written by any client. Same access shape as
    // /platform_audit_log above: no client read, no client write, only
    // the Admin SDK (server/notificationPlatform.ts), which bypasses
    // these rules entirely.
    // ==========================================================
    match /platform_event_dedupe/{dedupeKey} {
      allow read: if false;
      allow write: if false;
    }

    // ==========================================================
    // /platform_worker_state/{jobType} — Module #20 Phase 3 Checkpoint
    // 2 (Platform Infrastructure). Architecture §4.8.1's run-level
    // watermark (`lastRunCompletedAt`) — an optimization to narrow a
    // future scheduled producer's scan window, never the correctness
    // mechanism by itself (platform_event_dedupe above is). Same
    // access shape as /platform_audit_log and /platform_event_dedupe:
    // entirely client-inaccessible, Admin-SDK-only.
    // ==========================================================
    match /platform_worker_state/{jobType} {
      allow read: if false;
      allow write: if false;
    }
  }
}
