rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // [SuperAdmin Payment Operations V1 Launch Slice — ADR-0005]
    // platform_operators/{uid} is a structurally separate identity space
    // from users/{uid} (Architecture §7.4) — this helper never touches
    // myProfile() and myProfile() never touches this. Used only by the
    // platform_operators and platform_audit_log rules below; no
    // tenant-facing rule in this file reads it.
    function isPlatformOperator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/platform_operators/$(request.auth.uid));
    }

    // The signed-in user's own profile document (contains role + businessId,
    // and for owners with more than one shop, businessIds[] + activeBusinessId).
    // Used by nearly every rule below to establish membership/ownership.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // An owner's shop list. Owners created before multi-shop support only
    // ever have the legacy singular `businessId` — this never defaults to
    // that here (unlike the client's derived fallback) because rules must
    // check the field that's actually on the document; `isMemberOf` below
    // checks `businessId` directly as a separate, always-present clause.
    function ownedBusinessIds() {
      return myProfile().get('businessIds', []);
    }

    // Set exclusively by the server (server/index.ts, via the Admin SDK,
    // which bypasses these rules entirely) — never writable by the client
    // (see the users/{userId} update rule below). Checking it here means a
    // suspended staff member is denied at the data layer the instant this
    // field flips, rather than only once their Firebase Auth ID token
    // naturally expires.
    function isSuspended() {
      return myProfile().get('suspended', false) == true;
    }

    // [SuperAdmin V1 Operational Control Plane, Phase C — ADR-0006,
    // Gap 1, Product-Architect-confirmed] Business-level counterpart to
    // isSuspended() above — same shape, one level up: a live get() on
    // the business document rather than the caller's own profile. Set
    // exclusively by the privileged server (server/index.ts's
    // business-suspension routes, via the Admin SDK, which bypasses
    // these rules entirely) — never writable by the client (see the
    // businesses/{businessId} update rule below). Folded into
    // isMemberOf() so every existing isMemberOf/isOwnerOf consumer in
    // this file inherits the suspension check automatically, with no
    // per-collection rule edits — the same "one change, many
    // consumers" pattern isMemberOf/isOwnerOf themselves already are.
    //
    // [Correction to the fix above] The `let businessData = get(...).data`
    // approach was itself wrong — confirmed by a second real
    // emulator run showing the identical failures after that change
    // shipped. The actual Firestore Rules behavior (documented, not
    // guessed this time): `get()` on a path that doesn't exist FAILS
    // outright — it is the `get()` call itself that throws, not a
    // subsequent `.data` access on a null value. Assigning its result
    // to a `let` doesn't help, because the exception fires before the
    // assignment ever completes. The only safe way to conditionally
    // read a possibly-nonexistent document is to guard the `get()`
    // call itself behind `exists()` using `&&` short-circuit
    // evaluation, since `exists()` — unlike `get()` — never throws for
    // a missing document. This is exactly the pattern hasSubscription()
    // already uses elsewhere in this file; this function should have
    // matched it from the start. Costs one additional read (exists()
    // + get(), two reads total) compared to the original broken
    // single-get() version — an honest, necessary cost, not
    // introduced for convenience.
    function isBusinessSuspended(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.get('suspended', false) == true;
    }

    function isMemberOf(businessId) {
      return isSignedIn() && !isSuspended() && !isBusinessSuspended(businessId) && (
        myProfile().businessId == businessId ||
        businessId in ownedBusinessIds()
      );
    }

    // [Phase 0 Stage 1 — owner->admin migration] Accepts both the legacy
    // 'owner' value and the target 'admin' value so existing accounts
    // keep working unchanged while new/backfilled accounts can use either
    // value. This tolerance is intentionally temporary — see
    // docs/engineering/phase0-owner-admin-migration-implementation-plan.md.
    function isOwnerOf(businessId) {
      return isMemberOf(businessId) && (myProfile().role == 'owner' || myProfile().role == 'admin');
    }

    // BDS #16 (Staff & Roles) / Architecture 6.3 amendment. Manager is not
    // a new role — it's a permission-tier field on the same staff account.
    // Passes if the caller is the Admin (unchanged from isOwnerOf), OR the
    // caller is a Staff account promoted to 'manager', scoped to this exact
    // businessId (a Manager never has multi-shop reach, same as any Staff),
    // AND has been explicitly granted this specific permission — staffTier
    // alone grants nothing. staffTier/managerPermissions are themselves
    // writable only by the privileged server (server/index.ts), never by
    // the client, same guarantee as `suspended`.
    function isOwnerOrGrantedManager(businessId, permission) {
      return isOwnerOf(businessId) || (
        isMemberOf(businessId) &&
        myProfile().role == 'staff' &&
        myProfile().get('staffTier', 'staff') == 'manager' &&
        myProfile().businessId == businessId &&
        myProfile().get('managerPermissions', {}).get(permission, false) == true
      );
    }

    // [Module #20 Phase 1 (Foundations), Checkpoint 2] `notifications` is
    // this repository's first top-level (not business-nested) collection
    // — recipient scoping (spec 20.1/20.2) is expressed via document
    // fields (`scope`/`businessId`/`userId`) rather than a path segment,
    // unlike every isMemberOf/isOwnerOf use above. Mirrors the
    // /subscriptions read-scope shape below (Owner/Admin full access,
    // Manager-tier view-only, no specific granted permission required —
    // 20.2's "same 'view only' boundary already established for
    // Subscription visibility") re-expressed for a field-scoped, not
    // path-scoped, document.
    //
    // Suspension check: isMemberOf()/isOwnerOf() already fold in
    // !isSuspended() for the Business-scoped branch. For the User-scoped
    // branch this function applies the same platform-wide suspension cut
    // (see the "suspended member" test elsewhere in this repo's test
    // suite) rather than carving out an exception for a user's own
    // notifications — consistent existing behavior, not a new rule.
    function isNotificationRecipient(resource) {
      return resource.data.scope == 'business'
        ? (
            isOwnerOf(resource.data.businessId) || (
              isMemberOf(resource.data.businessId) &&
              myProfile().get('staffTier', 'staff') == 'manager'
            )
          )
        : (
            resource.data.scope == 'user' &&
            isSignedIn() && !isSuspended() &&
            resource.data.userId == request.auth.uid
          );
    }

    // [Closing Integrity Amendment v1.0] A rule cannot run a range query
    // ("does any Closing cover this date?") — it can only get() a document
    // at a known path. ClosedPeriod docs exist purely so this becomes a
    // deterministic lookup: split the incoming date "YYYY-MM-DD" and check
    // both possible period keys (monthly and yearly) for that business.
    // Must derive the exact same id shape as closedPeriodKey() in
    // AppContext.tsx — if that function ever changes, this must too.
    function isDateInsideClosedPeriod(businessId, dateStr) {
      let parts = dateStr.split('-');
      let year = parts[0];
      let month = parts[1];
      return exists(/databases/$(database)/documents/businesses/$(businessId)/closedPeriods/$('monthly:' + year + '-' + month)) ||
             exists(/databases/$(database)/documents/businesses/$(businessId)/closedPeriods/$('yearly:' + year));
    }

    // [Module #19 Phase 2 — Trial Engine] Restricted-Operations
    // Enforcement (Business Rule 6 / Phase 2 Decision 2, principle-based:
    // "operations that create, modify, or delete records affecting
    // Business Worth or financial position become unavailable after
    // trial completion unless an appropriate subscription state is
    // restored"). Applied to `create` only in this pass — the spec's own
    // Restricted-Operations Enforcement language is specifically about
    // "new operational record creation," and scoping to create keeps
    // this change reviewable without touching the already-battle-tested
    // closingId-based update/delete logic on Expenses/Withdrawals below.
    // Broadening to update/delete is a disclosed, deliberate follow-up
    // decision, not silently out of scope — see the Phase 2 report.
    //
    // hasSubscription()/subscriptionAllowsNewRecords() together fail
    // OPEN (permit the write) when no subscriptions/{businessId} document
    // exists at all. This is a deliberate, explicitly-flagged INTERIM
    // behavior: every Business created since Phase 1 (commit 4d9d34b)
    // always has one, but Businesses that predate Phase 1 do not yet —
    // the legacy migration that gives every existing Business an
    // explicit subscription record (spec's "Explicitly Left Open," item
    // 6) has not been built. Business Rule 4 ("no null subscription
    // states, ever") means this fail-open is accepted as temporary, not
    // permanent — it must not be read as "missing means unrestricted
    // forever." Denying instead (fail-closed) was rejected here because
    // it would lock every real, currently-operating pre-Phase-1 tenant
    // out of recording sales/purchases/expenses the moment this rule
    // deployed, with no migration having run yet to give them a
    // subscription document to be governed by in the first place.
    function hasSubscription(businessId) {
      return exists(/databases/$(database)/documents/subscriptions/$(businessId));
    }

    function subscriptionAllowsNewRecords(businessId) {
      return !hasSubscription(businessId) || (
        get(/databases/$(database)/documents/subscriptions/$(businessId)).data.status != 'trial_completed' &&
        get(/databases/$(database)/documents/subscriptions/$(businessId)).data.status != 'expired'
      );
    }

    // [Void & Redo — Implementation Authorization §2 item 7; Rule 8
    // Findings B1, E1] True only if stockCountId names a genuine,
    // currently-existing 'initial' StockCount for this business, with
    // a server-recorded confirmedAt (a target missing this field —
    // every 'initial' count confirmed before this feature existed — is
    // NEVER eligible; no timestamp is inferred, defaulted, or
    // substituted for it, per this task's explicit instruction), a
    // chainPosition other than 4 (the ceiling — Rule 8 Finding
    // E1/Specification §21: Confirmation #4 can never be voided, under
    // any circumstance, independent of whether its own window is still
    // open), and whose own 12-hour window [Recovery Window Amendment,
    // amending the original 30-minute value] — measured from its own
    // confirmedAt, compared against request.time (the server's trusted
    // clock, never a client-supplied value) — has not yet elapsed.
    // Used exclusively by the /voidRecords create rule below. The
    // redo-confirmation branches of the /stockCounts create rule
    // deliberately do NOT call this a second time — Rule 8 Finding D1
    // treats "was this predecessor legitimately voided" (proven by a
    // VoidRecord's mere existence, itself only creatable when this
    // function returned true) as a separate concern from re-checking
    // window/ceiling eligibility again at redo time.
    function initialStockConfirmationVoidable(businessId, stockCountId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)).data.get('type', null) == 'initial' &&
        get(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)).data.get('confirmedAt', null) != null &&
        get(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)).data.get('chainPosition', 1) != 4 &&
        // Safe direct (non-.get()) field access: the clause immediately
        // above already proved 'confirmedAt' is present and non-null on
        // this exact document, via short-circuit && evaluation order.
        request.time < get(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)).data.confirmedAt + duration.value(12, 'h');
    }

    // [SuperAdmin-Assisted Initial Stock Recovery — BDR-0016/POL-0009/
    // Specification/Rule 8 Findings C, D, E, G/Implementation Plan §6,
    // §7, §11/Implementation Authorization, signed 2026-08-21] The
    // second, additive eligibility gate into the SAME /voidRecords
    // create rule initialStockConfirmationVoidable() already governs —
    // never a second void-record mechanism (POL-0009 Rule M; Rule 8
    // Finding K). Deliberately does NOT re-check the ordinary 12-hour
    // confirmedAt window at all (POL-0009 Rule R: "completely separate
    // from the normal 12-hour confirmedAt recovery window") and, unlike
    // initialStockConfirmationVoidable(), does NOT require confirmedAt
    // to be present — this is precisely what makes a legacy
    // confirmation (no confirmedAt field at all) reachable through this
    // path (Rule 8 Finding D; Implementation Plan §7).
    //
    // Current-confirmation-only (POL-0009 Rule U; Rule 8 Finding E) is
    // enforced two ways here, exactly as Implementation Plan §6
    // specifies: (a) targetStockCountId on the Authorization document
    // must equal stockCountId — re-verified at grant time server-side,
    // never trusted from this check alone; (b) this function is reached
    // only from the /voidRecords create rule below, whose own fixed-id-
    // equals-stockCountId create-if-absent semantics already refuse a
    // second void-record for an already-superseded confirmation,
    // structurally — no separate "not yet voided" clause is needed here
    // because the caller (the /voidRecords create rule) cannot reach
    // this function at all for a stockCountId that already has a
    // voidRecords document.
    //
    // The chainPosition != 4 clause is independently required here
    // (Confirmation #4 remains absolutely non-voidable under every
    // path — POL-0009 §"CEILING" instruction; Implementation
    // Authorization Acceptance Criterion 12): a legacy confirmation has
    // no chainPosition field at all and defaults to 1 (never 4, so
    // never excluded by this clause — POL-0009 Rule W treats its first
    // authorized recovery as Confirmation #1); an expired-window,
    // non-legacy confirmation keeps its own real chainPosition (POL-0009
    // Rule X) and remains excluded here exactly as
    // initialStockConfirmationVoidable() already excludes it.
    function initialStockRecoveryAuthorizationActive(businessId, stockCountId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)).data.get('type', null) == 'initial' &&
        get(/databases/$(database)/documents/businesses/$(businessId)/stockCounts/$(stockCountId)).data.get('chainPosition', 1) != 4 &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/initialStockRecoveryAuthorization/$("current")) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/initialStockRecoveryAuthorization/$("current")).data.get('status', null) == 'unconsumed' &&
        get(/databases/$(database)/documents/businesses/$(businessId)/initialStockRecoveryAuthorization/$("current")).data.get('targetStockCountId', null) == stockCountId &&
        // Safe direct (non-.get()) field access: the clause immediately
        // above already proved this document exists and is
        // 'unconsumed', via short-circuit && evaluation order — the
        // same discipline initialStockConfirmationVoidable() already
        // uses for its own confirmedAt access, below.
        request.time < get(/databases/$(database)/documents/businesses/$(businessId)/initialStockRecoveryAuthorization/$("current")).data.expiresAt;
    }

    // ==========================================================
    // /users/{userId} - one profile doc per authenticated user
    // ==========================================================
    match /users/{userId} {
      // A user can always read their own profile. An owner can also read the
      // profiles of staff that belong to any of their own shops (e.g. staff
      // list) — checked against the legacy single businessId (covers staff
      // of the owner's original shop) and the full businessIds list (covers
      // staff of any additional shops added via addShop).
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          (myProfile().role == 'owner' || myProfile().role == 'admin') &&
          (myProfile().businessId == resource.data.businessId || resource.data.businessId in ownedBusinessIds())
        )
      );

      // Creating a profile happens in two flows:
      //  1) Self-registration - a brand new owner creating their own profile.
      //  2) An owner (or a Staff account granted the 'staffManagement'
      //     Manager permission, BDS #16) provisioning a staff account
      //     (created via a secondary Firebase Auth app, then written here
      //     under the creator's session). A Manager can only ever create a
      //     plain 'staff' profile here — never one with staffTier set to
      //     'manager' — promoting to Manager is a separate, Admin-only
      //     action (see the update rule below).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (request.resource.data.role == 'owner' || request.resource.data.role == 'admin')) ||
        (
          request.auth.uid != userId &&
          request.resource.data.role == 'staff' &&
          request.resource.data.get('staffTier', 'staff') == 'staff' &&
          isOwnerOrGrantedManager(request.resource.data.businessId, 'staffManagement')
        )
      );

      // A user may only update their own profile, and may never change their
      // own role, legacy business, or suspension status (each would be a
      // privilege-escalation path — suspended in particular must only ever
      // be flipped by the server via suspendStaffMember/reactivateStaffMember,
      // which use the Admin SDK and bypass these rules; otherwise a suspended
      // staff member could simply un-suspend themselves with a plain write).
      // staffTier and managerPermissions (BDS #16) get the identical
      // guarantee — set only by the server's set-tier endpoint, never by a
      // plain client write, otherwise a staff member could self-grant
      // Manager tier and every permission it unlocks in one write.
      // businessIds may only ever grow by exactly one entry per write,
      // and only if that new entry is a /businesses/{id} doc this uid
      // actually owns (checked server-side here, not just trusted from the
      // client) — otherwise anyone could hand themselves read/write access
      // to someone else's shop just by editing their own array. The 10-shop
      // cap is enforced here too, as a backstop to the client-side check.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
        request.resource.data.get('staffTier', 'staff') == resource.data.get('staffTier', 'staff') &&
        request.resource.data.get('managerPermissions', {}) == resource.data.get('managerPermissions', {}) &&
        isValidBusinessIdsChange() &&
        isValidActiveBusinessIdChange();

      function isValidBusinessIdsChange() {
        let oldIds = resource.data.get('businessIds', []);
        let newIds = request.resource.data.get('businessIds', []);
        return newIds == oldIds || (
          (resource.data.role == 'owner' || resource.data.role == 'admin') &&
          oldIds.size() < 10 &&
          newIds == oldIds.concat([newIds[newIds.size() - 1]]) &&
          get(/databases/$(database)/documents/businesses/$(newIds[newIds.size() - 1])).data.ownerUid == request.auth.uid
        );
      }

      function isValidActiveBusinessIdChange() {
        let newActive = request.resource.data.get('activeBusinessId', null);
        let newIds = request.resource.data.get('businessIds', []);
        return newActive == null || newActive in newIds;
      }

      // A user can delete their own profile. Owner-initiated removal of a
      // STAFF member's profile must go through the deleteStaffMember Cloud
      // Function (Admin SDK, bypasses these rules) — never directly from
      // the client — because that function also deletes the corresponding
      // Firebase Authentication account. A client-side delete here alone
      // would silently leave an orphaned Auth account behind.
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================================
    // /businesses/{businessId}
    // ==========================================================
    match /businesses/{businessId} {
      allow read: if isMemberOf(businessId);

      // A business is only ever created by its own owner (uid matches the
      // ownerUid on the new document), and the id doesn't exist yet.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;

      // Only the owner can change business settings (currency, category, name).
      // [Phase C — ADR-0006, Gap 1] `suspended` is excluded from what
      // this write can touch, in either direction — an Owner can
      // continue updating every field this rule already permitted
      // (currency, category, name, contact, location, email) but can
      // never set suspended:true (self-suspend, pointless but also not
      // a privilege-escalation risk) or suspended:false (self-
      // reactivate, the actual risk this guard exists to close).
      // Mirrors users/{userId}'s identical field-immutability idiom
      // for its own suspended/staffTier/managerPermissions fields.
      // Staff have no write path to this document at all, unaffected.
      allow update: if isOwnerOf(businessId) &&
        request.resource.data.get('suspended', false) == resource.data.get('suspended', false);
      allow delete: if false;

      // ----------------------------------------------------------
      // Operational data any team member (owner or staff) can read
      // and create, but only the owner can edit/delete.
      // ----------------------------------------------------------
      match /products/{productId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update, delete: if isOwnerOf(businessId);
      }

      // [Durable Purchase Capture Amendment v1.0] Reusable, tenant-scoped
      // Supplier entities — same access tier as /products above (any
      // team member can read/create, only the owner can edit/delete),
      // reused verbatim per the approved implementation's explicit
      // instruction not to invent a new "Supplier Manager" tier. Not a
      // valuation input anywhere — see the amendment's Part 10.
      match /suppliers/{supplierId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update, delete: if isOwnerOf(businessId);
      }

      match /batches/{batchId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Stock receipt — restricted once trial
        // completes/expires (Business Rule 6 / Decision 2).
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId);
        // Batches are also updated by staff/owner alike when a new batch
        // closes out the previous open one (addStockBatch / addMultipleStockBatches).
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      // [Fix #10 — transactional open-batch supersession] Per-product
      // concurrency anchor for addStockBatch's runTransaction. Not a
      // valuation input, not surfaced anywhere in the app UI, and read
      // by no code path other than the transaction that writes it — see
      // AppContext.tsx addStockBatch for the full reasoning. Access
      // mirrors /batches exactly (same staff/owner tier: staff can
      // create/update alongside an owner, matching that Stock Entry is
      // already a staff-permitted action per docs/specs/05-stock-batches.md),
      // since this doc is written in the same transaction as a batch
      // write and must never be gated more strictly than the batch write
      // itself. Never deleted — a stale/orphaned lock is harmless (the
      // transaction always re-validates the pointed-to batch's actual
      // `status` via a fresh read before trusting it, never the lock
      // doc's existence alone).
      match /openBatchLocks/{productId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if false;
      }

      // Purchase Batches (Investment Ledger) — the envelope grouping one or
      // more /batches line items into a single purchase/investment event.
      // Same access pattern as /batches: any team member can read/create,
      // any team member can update (archiving/unarchiving), only the owner
      // can delete.
      match /purchaseBatches/{purchaseBatchId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] New purchase — restricted once trial
        // completes/expires (Business Rule 6 / Decision 2). update
        // (archive/unarchive) is left unrestricted — organizing an
        // existing record doesn't create or change Business Worth.
        // [Durable Purchase Capture Amendment v1.0] supplierId is
        // optional and additive — when present, must be a string (a
        // reference to a /suppliers document; not itself dereferenced
        // here, matching this file's existing "cheap, deterministic
        // checks, no second read" pattern for shape-only validation).
        // [Multi-Supplier Purchase Event Amendment v1.0] purchaseEventId
        // is likewise optional and additive — when present, must be a
        // string (a client-generated correlation tag, not a document
        // reference). Same shape-only, no-second-read pattern as
        // supplierId above. The retroactive tagging of an
        // already-finalized PurchaseBatch (Part 7/14 of that amendment)
        // uses the update rule below, unmodified — this create-time
        // check only covers a purchaseEventId supplied at creation.
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId) &&
          (!('supplierId' in request.resource.data) || request.resource.data.supplierId is string) &&
          (!('purchaseEventId' in request.resource.data) || request.resource.data.purchaseEventId is string);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      match /quebras/{quebraId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Inventory adjustment — restricted once
        // trial completes/expires (Business Rule 6 / Decision 2).
        allow create: if isMemberOf(businessId) && subscriptionAllowsNewRecords(businessId);
        allow update: if isMemberOf(businessId);
        allow delete: if isOwnerOf(businessId);
      }

      // [Closing Integrity Amendment v1.0]
      //  - create: blocked if the entry's own date falls inside an
      //    already-closed period (Half 2 — protects the closed period
      //    itself, not just existing records).
      //  - update/delete: blocked once closingId is set (Half 1 — no
      //    client function currently calls update on an Expense, but the
      //    rule itself must not be laxer than the app, the same class of
      //    gap BDS #10 flagged for Stock Counts).
      match /expenses/{expenseId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2] Restricted once trial completes/expires
        // (Business Rule 6 / Decision 2), independent of and in addition
        // to the closed-period check already here.
        allow create: if isMemberOf(businessId) &&
          !isDateInsideClosedPeriod(businessId, request.resource.data.date) &&
          subscriptionAllowsNewRecords(businessId);
        allow update: if isMemberOf(businessId) && (
          resource.data.get('closingId', null) == null ||
          (isOwnerOf(businessId) && request.resource.data.get('closingId', null) == null)
        );
        allow delete: if isOwnerOf(businessId) &&
          resource.data.get('closingId', null) == null;
      }

      // Stock Counts (Initial Capital baseline + periodic physical counts).
      // These establish/verify business capital, so only the owner may
      // record or remove them; any team member may read them.
      match /stockCounts/{stockCountId} {
        allow read: if isMemberOf(businessId);

        // [Void & Redo — Implementation Authorization §2 item 7; Rule 8
        // Findings E1, F1, K1] The 'initial' StockCount is no longer
        // read as a single, forever fixed-id ('initial') singleton — it
        // may now be one of up to 4 confirmation events in a chain,
        // held at 4 fixed slot ids: 'initial' (chainPosition 1, the
        // ORIGINAL confirmation — the SAME id every confirmation has
        // always used, preserving exact backward compatibility with
        // every count confirmed before this feature and with the
        // currently-deployed app, which does not yet send
        // chainPosition/confirmedAt — that write path is UNCHANGED
        // below), and 'initial-2'/'initial-3'/'initial-4'
        // (chainPosition 2/3/4 — ONLY ever reachable via a legitimate
        // Void & Redo redo, never directly).
        //
        // [Security review, this step] The PRE-EXISTING rule placed no
        // id/content constraint on an 'initial'-type create at all —
        // the old singleton guarantee came entirely from the fixed-id
        // 'initial' create-if-absent trick, not from this rule. That
        // was harmless for a single ever-immutable record, but would
        // silently break Invariant I-1 (at most one active
        // confirmation) once the read path recognizes multiple
        // 'initial'-type documents per business (Finding F1) — a rogue
        // extra 'initial'-type document at an arbitrary id, written by
        // a direct API client bypassing the app UI, would otherwise be
        // indistinguishable from a real confirmation event. Closed here
        // by constraining every 'initial'-type create to exactly one of
        // the 4 named slot/chainPosition pairs below. This is a
        // technical implementation-task correction the new read-path
        // design (Finding F1) makes newly load-bearing — it does not
        // touch, weaken, or reinterpret any already-approved
        // BDR-0015/POL-0008 decision.
        allow create: if isOwnerOf(businessId) && (
          // Non-'initial' counts (periodic/weekly/monthly/etc.) —
          // entirely unaffected by this feature, unchanged rule.
          (request.resource.data.get('type', null) != 'initial' &&
            subscriptionAllowsNewRecords(businessId)) ||

          // The ORIGINAL confirmation, legacy shape — no chainPosition
          // field at all. Exactly what every 'initial' confirmation
          // ever written looks like today, and what the
          // currently-deployed, unmodified app still writes until a
          // later implementation step updates it. Firestore's own
          // create-if-absent semantics at the fixed id 'initial'
          // guarantee this succeeds at most once per business, exactly
          // as today.
          (request.resource.data.get('type', null) == 'initial' &&
            stockCountId == 'initial' &&
            !('chainPosition' in request.resource.data) &&
            subscriptionAllowsNewRecords(businessId)) ||

          // The ORIGINAL confirmation, new full shape (chainPosition 1,
          // server-verified confirmedAt) — forward-compatible with a
          // future app update (a later, separate implementation step);
          // requires no second rules deploy when that ships.
          (request.resource.data.get('type', null) == 'initial' &&
            stockCountId == 'initial' &&
            request.resource.data.get('chainPosition', null) == 1 &&
            request.resource.data.get('confirmedAt', null) == request.time &&
            subscriptionAllowsNewRecords(businessId)) ||

          // A REDO confirmation (chainPosition 2, 3, or 4). [Product
          // Architect Decision — Option A; Rule 8 §14, Finding K1] The
          // ONLY branch in this entire rule deliberately NOT gated on
          // subscriptionAllowsNewRecords — a valid recovery must remain
          // available even when normal new-record creation is blocked
          // by subscription/trial state. Requires, for every branch: a
          // server-verified confirmedAt (never client-supplied,
          // Finding B1); the correct fixed slot id for the claimed
          // chainPosition; redoesConfirmationId equal to EXACTLY the
          // immediate predecessor's own slot id (a hardcoded literal
          // per branch, never client-controlled — this is what
          // prevents a fabricated or skipped-link lineage); and a
          // VoidRecord already existing for that exact predecessor —
          // the sole proof of an already window/ceiling-checked,
          // legitimate void (Finding D1).
          (request.resource.data.get('type', null) == 'initial' &&
            request.resource.data.get('confirmedAt', null) == request.time &&
            (
              (request.resource.data.get('chainPosition', null) == 2 &&
                stockCountId == 'initial-2' &&
                request.resource.data.get('redoesConfirmationId', null) == 'initial' &&
                // NOTE: path segment given via $("...") deliberately,
                // not as a bare token — a hyphenated bare path segment
                // (e.g. .../voidRecords/initial-2) risks being
                // tokenized as a subtraction expression by the rules
                // parser rather than a literal path component; $(...)
                // with an explicit string forces it to be evaluated as
                // a value, avoiding that ambiguity entirely.
                exists(/databases/$(database)/documents/businesses/$(businessId)/voidRecords/$("initial"))) ||
              (request.resource.data.get('chainPosition', null) == 3 &&
                stockCountId == 'initial-3' &&
                request.resource.data.get('redoesConfirmationId', null) == 'initial-2' &&
                exists(/databases/$(database)/documents/businesses/$(businessId)/voidRecords/$("initial-2"))) ||
              (request.resource.data.get('chainPosition', null) == 4 &&
                stockCountId == 'initial-4' &&
                request.resource.data.get('redoesConfirmationId', null) == 'initial-3' &&
                exists(/databases/$(database)/documents/businesses/$(businessId)/voidRecords/$("initial-3")))
            )
          )
        );

        // [Amendment v1.0 — 10-expected-stock-value-amendment.md, Part 3]
        // The 'initial' count is Architecture 8.6's "no exceptions"
        // immutability tier — refused unconditionally, Owner included,
        // not merely a UI omission. Every other type keeps its prior
        // Owner-editable/deletable behavior unchanged. UNMODIFIED by
        // Void & Redo (Rule 8 Finding G1, Direction 2 — this line is
        // byte-for-byte identical to before this feature) — and, since
        // every confirmation event in a chain (original AND every
        // redo) is itself type: 'initial', this one unchanged line
        // automatically protects all of them, with no additional rule
        // needed.
        allow update, delete: if isOwnerOf(businessId) && resource.data.get('type', null) != 'initial';
      }

      // [Business Worth Evolution — Implementation Authorization,
      // Increment 1; Specification §8, FR-5-FR-7, I-2, I-3; Implementation
      // Plan §3.1, §14, §18] The frozen Business Worth measurement result
      // produced by a confirmed new-model Contagem. Tenant-scoped
      // identically to every other business-owned collection
      // (isMemberOf/isOwnerOf) — same read/create tier as stockCounts
      // immediately above, since a BusinessWorthSnapshot is always
      // created alongside a stockCounts write, in the SAME Firestore
      // batch (recordStockCount, AppContext.tsx), by the Owner only.
      //
      // [Increment 1 scope] Pure immutability — allow update, delete: if
      // false, unconditionally, with NO exception. This capability's own
      // Owner 3-hour correction window and SuperAdmin-authorized 72-hour
      // recovery (Specification §25-§26) are explicitly NOT implemented
      // in this Increment (per the Implementation Authorization's own
      // Increment 1 scope, item 7: "Do not create a general-purpose
      // update/delete mechanism for snapshots... The later recovery
      // mechanism is NOT being implemented in Increment 1"). A future
      // Increment 8 will add ONE additive, narrowly-scoped `||` branch
      // to the update rule for the status-only correction/recovery
      // transition (mirroring exactly how the SuperAdmin-Assisted
      // Initial Stock Recovery capability added its own single additive
      // branch to the pre-existing voidRecords rule below, without
      // touching anything else in that rule) — never a general-purpose
      // update path, and never by editing this comment's own "if false"
      // line in place without that being its own reviewed, cited change.
      //
      // [FR-37 idempotency; Rule 8 Finding 10-A] Document id is a
      // deterministic function of sourceStockCountId ('bws-' + the
      // source StockCount's own id) — Firestore's own create-if-absent
      // semantics are what guarantee I-2 ("no two BusinessWorthSnapshot
      // documents share a sourceStockCountId"), the identical mechanism
      // the pre-existing 'initial' stockCounts singleton and voidRecords
      // fixed-id convention already rely on elsewhere in this file. A
      // genuine retried confirmation attempt is correctly REJECTED here
      // as an update-to-an-existing-document (matching this file's own
      // existing 'initial' stockCounts precedent for the identical class
      // of retry, immediately above) rather than silently accepted as an
      // overwrite — silently overwriting would let a retry's fresh
      // serverTimestamp() rewrite this snapshot's own supposedly-frozen
      // confirmedAt, which this rule must never allow.
      match /businessWorthSnapshots/{snapshotId} {
        allow read: if isMemberOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('businessId', null) == businessId &&
          request.resource.data.get('id', null) == snapshotId &&
          // [Rule 8 Finding B1 — same discipline as StockCount.confirmedAt]
          // Server-verified, never client-supplied — this is what makes
          // the future 3-hour correction window (Increment 8) untamperable
          // by a client-computed confirmedAt, exactly as
          // initialStockConfirmationVoidable()'s 12-hour window already
          // relies on for stockCounts.
          request.resource.data.get('confirmedAt', null) == request.time &&
          // Increment 1 never creates any status other than 'active' — no
          // correction/recovery mechanism exists yet to produce another.
          request.resource.data.get('status', null) == 'active' &&
          request.resource.data.get('sourceStockCountId', null) is string &&
          request.resource.data.get('measuredBusinessWorth', null) is number;
        allow update, delete: if false;
      }

      // [Business Worth Evolution — Implementation Authorization,
      // Increment 3; Specification §10, §33, I-4] Owner-only tier (same
      // access class as withdrawals — Staff never handles cash/debt
      // records). Append-only: no update or delete path exists for any
      // role, at any time. Category is restricted to the exact five
      // accepted governed-event values (§10) — never an arbitrary string
      // — matching the closed-enum discipline this file already applies
      // elsewhere (e.g. BusinessWorthSnapshot.status, above).
      match /cashLedgerEntries/{entryId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('businessId', null) == businessId &&
          request.resource.data.get('id', null) == entryId &&
          request.resource.data.get('direction', null) in ['inflow', 'outflow'] &&
          request.resource.data.get('amount', null) is number &&
          request.resource.data.get('amount', 0) > 0 &&
          request.resource.data.get('category', null) in
            ['customer-payment', 'supplier-payment', 'expense', 'levantamento', 'other-governed-movement'] &&
          request.resource.data.get('createdBy', null) == request.auth.uid;
        allow update, delete: if false;
      }

      // [Business Worth Evolution — Implementation Authorization,
      // Increment 3; Specification §11, §33] Owner-only tier. `create`
      // requires the fresh-record invariants (zero paid, remaining ==
      // total, status 'unpaid') so a client cannot create an
      // already-partially-settled Receivable out of thin air. `update`
      // is restricted to exactly the three fields a payment is allowed
      // to change (amountPaid/amountRemaining/status) — totalAmount,
      // createdAt, description, debtorName remain immutable after
      // creation, the same "lock the historical fact, allow only the
      // governed state transition" discipline `closings`' own per-field
      // lock already establishes elsewhere in this file.
      match /receivables/{receivableId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('businessId', null) == businessId &&
          request.resource.data.get('id', null) == receivableId &&
          request.resource.data.get('totalAmount', null) is number &&
          request.resource.data.get('totalAmount', 0) > 0 &&
          request.resource.data.get('amountPaid', null) == 0 &&
          request.resource.data.get('amountRemaining', null) == request.resource.data.get('totalAmount', null) &&
          request.resource.data.get('status', null) == 'unpaid';
        allow update: if isOwnerOf(businessId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaid', 'amountRemaining', 'status']) &&
          request.resource.data.get('status', null) in ['unpaid', 'partially-paid', 'paid'];
        allow delete: if false;
      }

      // [Business Worth Evolution — Implementation Authorization,
      // Increment 3; Specification §11, FR-13, I-4] Append-only — a
      // payment, once recorded, is never edited or removed (mirrors
      // CashLedgerEntry's own I-4 discipline). Document id is the
      // caller's own submissionId (FR-49/idempotency) — Firestore's
      // create-if-absent semantics are what make a retried write with
      // the same id a safe no-op rather than a silent duplicate, the
      // identical mechanism this file already relies on for
      // businessWorthSnapshots' own 'bws-' + sourceStockCountId id.
      match /receivablePayments/{paymentId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('id', null) == paymentId &&
          request.resource.data.get('receivableId', null) is string &&
          request.resource.data.get('amountPaid', null) is number &&
          request.resource.data.get('amountPaid', 0) > 0 &&
          request.resource.data.get('cashLedgerEntryId', null) is string;
        allow update, delete: if false;
      }

      // [Business Worth Evolution — Implementation Authorization,
      // Increment 3; Specification §12, §33] Mirrors receivables' own
      // rule exactly, for the liability side. `sourcePurchaseBatchId` is
      // required (§12) — a Payable never exists independent of the
      // PurchaseBatch/StockBatch it originated from.
      match /payables/{payableId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('businessId', null) == businessId &&
          request.resource.data.get('id', null) == payableId &&
          request.resource.data.get('sourcePurchaseBatchId', null) is string &&
          request.resource.data.get('totalAmount', null) is number &&
          request.resource.data.get('totalAmount', 0) > 0 &&
          request.resource.data.get('amountPaid', null) == 0 &&
          request.resource.data.get('amountRemaining', null) == request.resource.data.get('totalAmount', null) &&
          request.resource.data.get('status', null) == 'unpaid';
        allow update: if isOwnerOf(businessId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaid', 'amountRemaining', 'status']) &&
          request.resource.data.get('status', null) in ['unpaid', 'partially-paid', 'paid'];
        allow delete: if false;
      }

      // [Business Worth Evolution — Implementation Authorization,
      // Increment 3; Specification §12, FR-15, I-4] Mirrors
      // receivablePayments' own append-only/idempotent-id rule exactly,
      // for the liability side.
      match /payablePayments/{paymentId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('id', null) == paymentId &&
          request.resource.data.get('payableId', null) is string &&
          request.resource.data.get('amountPaid', null) is number &&
          request.resource.data.get('amountPaid', 0) > 0 &&
          request.resource.data.get('cashLedgerEntryId', null) is string;
        allow update, delete: if false;
      }

      // [Void & Redo — Implementation Authorization §2 item 2; Rule 8
      // Finding G1, Direction 2 (adopted)] The additive, create-only
      // artifact recording that a confirmation event has been voided —
      // WITHOUT ever mutating the original document above (POL-0008
      // Rule D/Rule I; BDR-0015 §3 item 3). Document id is fixed to
      // equal the id of the confirmation it voids ('initial',
      // 'initial-2', or 'initial-3' — NEVER 'initial-4', enforced by
      // initialStockConfirmationVoidable() below) — Firestore's own
      // create-if-absent semantics are therefore what guarantee "at
      // most one VoidRecord per confirmation, ever" (I-2) and "two
      // simultaneous void attempts cannot both succeed" (FR-27), with
      // no query or transaction needed — the identical mechanism the
      // pre-existing 'initial' singleton (above) already relies on for
      // the same class of guarantee.
      match /voidRecords/{stockCountId} {
        allow read: if isMemberOf(businessId);

        // [Product Architect Decision — Option A; Rule 8 §14, Finding
        // K1] Deliberately NOT gated on subscriptionAllowsNewRecords —
        // a valid recovery must remain available even when normal
        // new-record creation is blocked by subscription/trial state.
        // Every precondition below is fully enforced regardless of
        // subscription state; this exemption applies to this create
        // rule alone, expressed via these Void & Redo-specific
        // conditions directly, and to no other write path in this
        // file (Option A item 3, verbatim: "NOT authorization to
        // bypass subscription enforcement generally").
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.get('voidedConfirmationId', null) == stockCountId &&
          // Tenant isolation is structural, not merely checked: the
          // target lookup inside initialStockConfirmationVoidable() (and,
          // identically, inside initialStockRecoveryAuthorizationActive()
          // below) is scoped under businesses/$(businessId) — the SAME
          // businessId this create rule itself is scoped under (bound
          // from the URL path, never from request data) — so a
          // confirmation belonging to a different business can never be
          // reached from here, by construction, regardless of what id a
          // client supplies.
          //
          // [SuperAdmin-Assisted Initial Stock Recovery — POL-0009 Rule
          // M; Rule 8 Finding C/K; Implementation Plan §10/§11] The
          // ONLY change to this rule for this capability: one additive
          // `||` branch. The pre-existing initialStockConfirmationVoidable(...)
          // condition is completely unchanged — every confirmation
          // eligible under the ordinary Owner-only 12-hour path remains
          // exactly as eligible as before this capability existed.
          (initialStockConfirmationVoidable(businessId, stockCountId) ||
            initialStockRecoveryAuthorizationActive(businessId, stockCountId));

        // [POL-0008 Rule I; I-8] Create-only, forever. No historical
        // fact of a voided confirmation — including the fact that it
        // is voided — is ever rewritten once set.
        allow update, delete: if false;
      }

      // [SuperAdmin-Assisted Initial Stock Recovery — BDR-0016/POL-0009/
      // Specification/Rule 8 Findings A, B, F/Implementation Plan §2,
      // §5, §9, §10, §11/Implementation Authorization, signed
      // 2026-08-21] The Authorization artifact itself. Fixed id
      // ('current') per business — "at most one active Authorization
      // per business" (POL-0009 Rule T) is a structural property of
      // this collection's own create-if-absent-per-fixed-id semantics,
      // not a query-then-write race, exactly as the pre-existing
      // 'initial' stockCounts slot and the voidRecords fixed-id
      // convention already establish elsewhere in this file.
      match /initialStockRecoveryAuthorization/{docId} {
        allow read: if isMemberOf(businessId);

        // [Rule 8 Finding B; Implementation Plan §9] Grant is a
        // privileged-server action (POST /api/superadmin/initial-stock-
        // recovery/:businessId/authorize, gated by requirePlatformOperator
        // + requireSuperAdmin, server/initialStockRecoveryAuthorization.ts),
        // performed via the Admin SDK inside a Firestore transaction —
        // NEVER a client-side Firestore write, by any role, including an
        // authenticated platform_operators/{uid}. This mirrors
        // platform_operators' and platform_audit_log's own existing
        // "allow write: if false, Admin-SDK-only" pattern exactly (POL-0009
        // Rule N: SuperAdmin's write surface is structurally incapable of
        // reaching this document from a client, not merely discouraged by
        // UI omission).
        allow create: if false;

        // [Consumption & Audit Amendment §8; Supplementary
        // Implementation Authorization, signed 2026-08-21] SUPERSEDED —
        // consumption is no longer a client-reachable write. It now
        // happens exclusively via POST /api/initial-stock-recovery/consume
        // (requireAuth + server-side Owner-of-business verification,
        // server/initialStockRecoveryConsumption.ts), inside a Firestore
        // Admin SDK transaction that bypasses this rules file entirely —
        // identical in kind to how the grant itself already works. This
        // is a strict NARROWING of client-reachable surface, not a
        // widening: removing a client-reachable `allow update` path
        // (even the narrow, field-locked one this comment used to
        // describe) in favor of a fully server-mediated path means no
        // client credential, Owner included, can directly manipulate
        // this document at all. `allow update: if false` below is
        // therefore now correct and complete — Owner-tier consumption
        // is enforced by requireAuth + the server module's own
        // resolveIsOwnerOfBusiness() check, not by a rules condition.
        allow update: if false;

        // [POL-0009 Rule Z; Rule 8 Finding H] No historical fact of a
        // consumed Authorization is ever rewritten once set, and this
        // artifact is never deleted (its history is the permanent
        // record, matching the voidRecords/platform_audit_log
        // discipline already established elsewhere in this file).
        allow delete: if false;
      }

      // [Amendment v1.0 — 10-expected-stock-value-amendment.md, Part 1]
      // Persistent, pre-confirmation Initial Stock draft. Provisional and
      // pre-decisional — narrower than stockCounts' own read rule
      // (isMemberOf): Owner-only at every layer, matching this module's
      // Users table. Never itself Initial Capital.
      match /stockCountDrafts/{draftId} {
        allow read: if isOwnerOf(businessId);
        allow create, update: if isOwnerOf(businessId) && subscriptionAllowsNewRecords(businessId);
        // Deleting/clearing the draft (including the delete that happens
        // as part of confirmation) is never subscription-gated, matching
        // every other collection's delete rule in this file — a blocked
        // subscription should never trap an owner unable to clean up
        // their own provisional draft.
        allow delete: if isOwnerOf(businessId);
      }

      // [Durable Purchase Capture Amendment v1.0] Persistent, per-user
      // Purchase Draft — the Add Stock analogue of stockCountDrafts
      // above, deliberately narrower in a different way: NOT Owner-only
      // (Add Stock is already isMemberOf-tier, matching /batches and
      // /purchaseBatches above — this is everyday operational recording,
      // not the Owner-exclusive, capital-defining Initial Stock action),
      // but scoped per-user via the document ID itself. draftId MUST
      // equal the caller's own uid — this is the entire concurrency
      // model (Rule 8 Assessment, Section 7/11): two team members'
      // drafts are two different documents by construction, so this
      // check alone is sufficient, no ownership field needed. Never
      // itself inventory — see the amendment's Part 10.
      match /purchaseDrafts/{draftId} {
        allow read, create, update: if isMemberOf(businessId) &&
          request.auth.uid == draftId &&
          subscriptionAllowsNewRecords(businessId);
        // Deleting/clearing the draft (including the delete that
        // happens atomically as part of finalization,
        // addMultipleStockBatches) is never subscription-gated, same
        // reasoning as stockCountDrafts' own delete rule above — a
        // blocked subscription must never trap someone unable to clean
        // up (or finalize past) their own provisional draft.
        allow delete: if isMemberOf(businessId) && request.auth.uid == draftId;
      }

      // [Initial Stock Valuation History] Immutable, append-only audit
      // trail of price changes affecting units still remaining from the
      // original 'initial' StockCount — NEVER an edit to that StockCount
      // (which keeps its own unconditional no-update/no-delete rule
      // above, untouched by this feature). Owner-only at every layer,
      // same tier as recording the 'initial' count itself — this affects
      // how the business's capital is valued going forward, so Staff
      // never create or modify these, though any team member may read
      // them (same read tier as stockCounts).
      match /initialStockPriceChangeEvents/{eventId} {
        allow read: if isMemberOf(businessId);
        // [Module #19 Phase 2 pattern] Restricted once trial completes/
        // expires (Business Rule 6 / Decision 2), matching every other
        // capital-affecting create rule in this file. Field-shape
        // validation mirrors /payments' own pattern: the write must be
        // self-consistent (own businessId, own author) and cannot arrive
        // pre-negative — cheap, deterministic checks the rules layer can
        // make without a second read.
        allow create: if isOwnerOf(businessId) &&
          subscriptionAllowsNewRecords(businessId) &&
          request.resource.data.businessId == businessId &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.quantityRemaining is number &&
          request.resource.data.quantityRemaining > 0 &&
          request.resource.data.newCostPrice is number &&
          request.resource.data.newCostPrice >= 0 &&
          request.resource.data.newSellingPrice is number &&
          request.resource.data.newSellingPrice >= 0;
        // Historical valuation records are immutable once created —
        // AUDITABILITY requirement: "create event" over "edit previous
        // event", no post-creation correction mechanism exists or is
        // authorized. Same unconditional "no exceptions" tier as the
        // 'initial' StockCount and /payments — Owner included.
        allow update: if false;
        allow delete: if false;
      }

      // Owner Withdrawals: money taken by the owner personally. Only the
      // owner may record/edit/remove these — staff never handle this.
      // [Closing Integrity Amendment v1.0] Same create/update/delete
      // protections as Expenses, above — see that comment for the rule.
      match /withdrawals/{withdrawalId} {
        allow read: if isOwnerOf(businessId);
        // [Module #19 Phase 2] Changes financial position directly —
        // restricted once trial completes/expires (Business Rule 6 /
        // Decision 2), same as Expenses above.
        allow create: if isOwnerOf(businessId) &&
          !isDateInsideClosedPeriod(businessId, request.resource.data.date) &&
          subscriptionAllowsNewRecords(businessId);
        allow update: if isOwnerOf(businessId) && (
          resource.data.get('closingId', null) == null ||
          request.resource.data.get('closingId', null) == null
        );
        allow delete: if isOwnerOf(businessId) &&
          resource.data.get('closingId', null) == null;
      }

      // Payments (Module #19 V1 Manual Payment Bridge) — a temporary
      // confirmation bridge, NOT the final payment architecture.
      // Deliberately NOT gated by subscriptionAllowsNewRecords(): this
      // is the one write path that must remain reachable specifically
      // WHILE a subscription is trial_completed/expired — it is the
      // Owner's way out of that state, not another kind of operational
      // record that state is meant to restrict.
      //
      // Only the Owner may submit (never Staff — this mirrors
      // Withdrawals' owner-only access, since subscription payment is
      // an owner-level financial matter). A submission must always
      // start 'pending', with no confirmation fields present — the
      // client can never create an already-confirmed record. Once
      // created, a Payment is immutable from the client's side in
      // every respect: no update, no delete. Only the server-side
      // confirmation mechanism (Admin SDK, bypasses these rules
      // entirely, per Implementation Authorization §5 "server-side
      // only... not callable by an ordinary tenant user") may ever
      // transition it to confirmed/rejected.
      match /payments/{paymentId} {
        allow read: if isOwnerOf(businessId);
        allow create: if isOwnerOf(businessId) &&
          request.resource.data.businessId == businessId &&
          request.resource.data.submittedBy == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.currency == 'MZN' &&
          !request.resource.data.keys().hasAny(['confirmedAt', 'confirmedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason']);
        allow update: if false;
        allow delete: if false;
      }

      // Monthly/Yearly Closings: permanently lock a period's figures. The
      // Admin can always do this; a Staff account promoted to Manager can
      // too, but only if explicitly granted the 'closings' permission
      // (BDS #16 / Architecture 6.3) — staffTier === 'manager' alone is
      // not enough. A plain Staff member never handles this, same as today.
      //
      // [Closing Integrity Amendment v1.0 — fixes a real gap found during
      // implementation] Reopening (update, setting status: 'reopened') is
      // deliberately NOT covered by the same Manager grant that covers
      // create — the amendment's Decisions Record is explicit that a
      // Manager who can *record* a Closing is not automatically a Manager
      // who should be able to *un*-close one. Before this amendment, this
      // rule allowed a granted Manager to delete (and thereby reopen) any
      // Closing — that gap is closed here, not just documented. A Closing
      // is also never deleted anymore — reopening supersedes it in place
      // (recordClosing/reopenClosing, AppContext.tsx).
      match /closings/{closingId} {
        allow read, create: if isOwnerOrGrantedManager(businessId, 'closings');
        allow update: if isOwnerOf(businessId);
        allow delete: if false;
      }

      // [Closing Integrity Amendment v1.0] Lock-index docs — see
      // ClosedPeriod in types.ts. Written alongside a Closing (create,
      // same permission), deleted only by an Owner reopening a period
      // (reopenClosing) — never by a Manager, matching the closings rule
      // above. Never updated in place.
      match /closedPeriods/{periodKey} {
        allow read: if isMemberOf(businessId);
        allow create: if isOwnerOrGrantedManager(businessId, 'closings');
        allow update: if false;
        allow delete: if isOwnerOf(businessId);
      }

      // Staff roster management: the Admin can always do this. A Staff
      // account promoted to Manager can too, but only with the
      // 'staffManagement' permission explicitly granted (BDS #16). A
      // Manager can never touch another Manager's or the Admin's record —
      // that guard lives server-side (server/index.ts), since it depends
      // on the *target's* tier, which a rule reading only the caller's
      // profile can't safely evaluate without an extra read per write.
      // Deletion is intentionally NOT allowed from the client for anyone
      // (allow delete: if false) — removing a staff member must go through
      // the deleteStaffMember server endpoint so their Firebase
      // Authentication account is deleted in the same operation, never
      // leaving an orphaned login behind. That endpoint enforces the
      // Admin-or-granted-Manager check itself.
      match /staff/{staffId} {
        allow read, create, update: if isOwnerOrGrantedManager(businessId, 'staffManagement');
        allow delete: if false;
      }

      // Business Timeline: an append-only history log written alongside the
      // actions above (e.g. a staff member adding stock also writes the
      // matching timeline entry). Any team member can read and create
      // entries; entries are never edited once written — only the owner can
      // remove one (used solely by clearAllData / data reset).
      match /timelineEvents/{timelineEventId} {
        allow read: if isMemberOf(businessId);
        allow create: if isMemberOf(businessId);
        allow update: if false;
        allow delete: if isOwnerOf(businessId);
      }
    }

    // ==========================================================
    // /subscriptions/{subscriptionId} - one doc per Business
    // (subscriptionId === businessId, per docs/specs/19-subscriptions.md
    // "Data Model"). Module #19, Phase 1 (Foundations) + Phase 2
    // (Trial Engine) -- Phase 2 adds two more Admin-SDK-only writers
    // (the activate-trial endpoint and the Trial Lifecycle Worker) but
    // does not change this block's rules: still no client write path.
    //
    // Read scope deliberately narrower than plain isMemberOf(businessId):
    // the spec's Security Considerations section (§616-622) says this
    // document is readable by "that Business's own Admin/Manager (view)"
    // — not by every team member. Regular (non-Manager) Staff has no
    // read access here, unlike most other collections in this file.
    // (Rule 8 Assessment, Module #19 Phase 1, Decision 2 — approved.)
    //
    // Every write (creation by the Business Provisioning Orchestrator,
    // future SuperAdmin overrides, future billing-webhook updates) goes
    // through server/index.ts via the Admin SDK, which bypasses these
    // rules entirely — allow write is unconditionally false here, same
    // guarantee as `suspended`/`staffTier`/`managerPermissions` on
    // /users/{userId}. No client path may ever write a subscription.
    // ==========================================================
    match /subscriptions/{subscriptionId} {
      allow read: if isOwnerOf(subscriptionId) || (
        isMemberOf(subscriptionId) &&
        myProfile().get('staffTier', 'staff') == 'manager'
      );
      allow write: if false;
    }

    // ==========================================================
    // /notifications/{notificationId} — Module #20 Phase 1
    // (Foundations), Checkpoint 2. Top-level collection (spec 20.1) —
    // see isNotificationRecipient() above for why this is field-scoped
    // rather than path-scoped.
    //
    // - read: Business-scoped visible to that Business's Owner/Admin and
    //   Manager-tier staff (view-only, no specific permission required —
    //   20.2); User-scoped visible only to the matching uid. Never a
    //   plain (non-Manager) Staff member for Business-scoped documents.
    // - create: always false. No client ever creates a notification, in
    //   any phase (Decision Gate 2) — only the privileged server, the
    //   Background Worker, or the payment webhook handler, all via the
    //   Admin SDK, which bypasses these rules. No producer exists yet in
    //   Phase 1 regardless (Checkpoint 2 ships only a persistence
    //   helper, unwired to any producer).
    // - update: permitted only as a single-field `status` transition, by
    //   a caller who already satisfies the read condition above. This is
    //   the one client-direct write path this collection has, covering
    //   both the "mark read" and "dismiss" UI actions — POL-20-001
    //   Decision 1 explicitly couples them onto this same field
    //   ("dismissing a notification automatically marks it read"; the
    //   approved data model, 20.1, has no separate dismissal field).
    //   Every other field is immutable after creation (POL-20-001
    //   Decision 4, Notification Immutability) — enforced here by
    //   requiring every field but `status` to be unchanged, the same
    //   field-by-field-equality idiom used by /users/{userId}'s own
    //   update rule above, rather than introducing a new diff()/
    //   affectedKeys() mechanism this file hasn't used before.
    // - delete: always false. No automatic or client-initiated deletion
    //   in V1 (POL-20-001 Decision 3).
    // ==========================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isNotificationRecipient(resource);

      allow create: if false;

      allow update: if isSignedIn() && isNotificationRecipient(resource) &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.payloadRef == resource.data.payloadRef &&
        request.resource.data.channel == resource.data.channel &&
        request.resource.data.dedupeKey == resource.data.dedupeKey &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.context == resource.data.context &&
        request.resource.data.priority == resource.data.priority &&
        // [Priority Reconciliation Amendment, v1.3] `importance` is a
        // new field (20.1) alongside `priority` — POL-20-001 Decision 4
        // (Notification Immutability) already covers "every field but
        // status"; this line keeps that existing guarantee true for the
        // new field rather than leaving it silently unenforced. Not a
        // new client read/write surface — `importance` was never
        // client-writable before this line existed, since `create` is
        // unconditionally false above; this only closes the same
        // immutability net around a field that didn't exist yet when
        // that net was first drawn.
        //
        // [Fix #5] Null-safe .get() form, not direct dot access. The
        // Amendment's own Migration Statement (§4) says existing Phase
        // 1/2 notifications — written before this field existed —
        // "remain valid as-is" and require no migration, and §5 says
        // this Amendment "does not change firestore.rules' existing
        // /notifications/{id} read/write rules". Direct dot access on a
        // field that's genuinely absent on those documents throws a
        // Rules evaluation error instead of a clean deny, which broke
        // exactly the read/dismiss action §4/§5 promised would keep
        // working unchanged. .get(field, null) restores that: absent on
        // both sides compares null == null (passes, matching pre-
        // Amendment behavior for legacy documents), present-and-
        // unchanged still passes (the actual immutability guarantee
        // this line exists for), present-and-changed still correctly
        // fails.
        request.resource.data.get('importance', null) == resource.data.get('importance', null) &&
        (request.resource.data.status == 'unread' || request.resource.data.status == 'read');

      allow delete: if false;
    }

    // ==========================================================
    // /platform_operators/{uid} — Architecture §7.4/§9.1, first real
    // population by the SuperAdmin Payment Operations V1 Launch Slice
    // (ADR-0005). Structurally separate identity space from
    // users/{uid} — see isPlatformOperator() above.
    //
    // - read: an operator may read only their OWN document — needed for
    //   the SuperAdmin app shell to gate its own nav at load (§9.1's
    //   "reads platform_operators/{uid}.platformRole once at load"
    //   principle). Never a list/scan of other operators from the
    //   client — §9.12's own internal-account-management screen (not
    //   part of this slice) is where that capability, if ever needed,
    //   is separately designed and gated.
    // - write: always false. Provisioning is Admin-SDK-only (§7.4:
    //   "provisioned by an existing SuperAdmin... never self-service
    //   signup") — no client, including an existing platform operator,
    //   may write this collection. A tenant account can never promote
    //   itself to platform operator through this rule, by construction.
    // ==========================================================
    match /platform_operators/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }


    // ==========================================================
    // /platform_audit_log/{eventId} - append-only, system-written only.
    // Module #19 Phase 2 (Trial Engine), Decision 4 — automatic
    // lifecycle transitions (trial activated/completed, and future
    // grace-period/expiry/renewal events) are audited the same way
    // Business Rule 8 already requires for SuperAdmin overrides.
    //
    // [SuperAdmin Payment Operations V1 Launch Slice — ADR-0005 §5,
    // BDS FR-7/NFR-2] Architecture §9.6 scopes read access to
    // platform-operator roles (Support/Developer/SuperAdmin). Until
    // this slice, that role model didn't exist yet in this rules file,
    // so read was unconditionally false for everyone — read access is
    // now granted, narrowly, to any verified platform_operators/{uid}
    // (isPlatformOperator(), above). This is NOT scoped further to
    // 'superadmin' specifically at the rules layer: §9.6 itself says
    // Support/Developer/SuperAdmin all have at least partial read
    // access to this log (Support: own actions only — a filter this
    // rules layer cannot express per-entry without a second read per
    // document, so V1's actual UI-level restriction to SuperAdmin-only
    // — BDS §3/§11 — is enforced by the privileged server's
    // requireSuperAdmin, not by this rule; a non-SuperAdmin platform
    // operator with read access at the rules layer but no route that
    // will serve them anything is the deliberately narrower, safer
    // side to be wrong on, consistent with defense-in-depth). Every
    // write still goes through server/index.ts via the Admin SDK,
    // which bypasses these rules entirely, same guarantee as
    // /subscriptions above — allow write remains unconditionally false
    // for every client, platform operator included.
    // ==========================================================
    match /platform_audit_log/{eventId} {
      allow read: if isPlatformOperator();
      allow write: if false;
    }


    // ==========================================================
    // /platform_event_dedupe/{dedupeKey} — Module #20 Phase 3
    // Checkpoint 2 (Platform Infrastructure). The dedupe/watermark
    // mechanism Architecture §4.8.1 names (one of its two candidate
    // shapes — see server/notificationPlatform.ts's own comment for
    // the engineering rationale). Records that a producer-owned
    // BusinessEvent dedupeKey has been evaluated (ADR-0004 Decision 2),
    // independent of whether that evaluation produced a notification.
    // Purely internal platform state — never a business fact, never
    // read or written by any client. Same access shape as
    // /platform_audit_log above: no client read, no client write, only
    // the Admin SDK (server/notificationPlatform.ts), which bypasses
    // these rules entirely.
    // ==========================================================
    match /platform_event_dedupe/{dedupeKey} {
      allow read: if false;
      allow write: if false;
    }

    // ==========================================================
    // /platform_worker_state/{jobType} — Module #20 Phase 3 Checkpoint
    // 2 (Platform Infrastructure). Architecture §4.8.1's run-level
    // watermark (`lastRunCompletedAt`) — an optimization to narrow a
    // future scheduled producer's scan window, never the correctness
    // mechanism by itself (platform_event_dedupe above is). Same
    // access shape as /platform_audit_log and /platform_event_dedupe:
    // entirely client-inaccessible, Admin-SDK-only.
    // ==========================================================
    match /platform_worker_state/{jobType} {
      allow read: if false;
      allow write: if false;
    }
  }
}
