# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase config - REQUIRED. The app will fail to authenticate or load any
# data without these. Get these values from your Firebase project settings
# (Project settings > General > Your apps > SDK setup and configuration).
# Shared, unchanged, by apps/superadmin too (Architecture §9.1: SuperAdmin
# "shares the same Firebase project" as the tenant app) — no separate
# SuperAdmin Firebase config exists or is needed.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-project"
VITE_FIREBASE_STORAGE_BUCKET="my-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Server-side only (never prefixed with VITE_, never sent to the browser).
# Powers server/index.ts — the Express endpoint that permanently deletes a
# staff member's Firebase Authentication account. Generate a service
# account key in Firebase Console > Project Settings > Service Accounts,
# then base64-encode the downloaded JSON file:
#   base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64="BASE64_ENCODED_SERVICE_ACCOUNT_JSON"

# ALLOWED_ORIGIN: optional. server/index.ts also serves the built SPA, so in
# the normal Railway deployment (one host serving both the app and /api/*)
# requests are same-origin and this isn't required. It only matters if the
# API is ever split onto its own host, or you're calling /api/* from a
# different domain.
# WARNING: if unset, CORS falls back to accepting ANY origin
# (`origin: process.env.ALLOWED_ORIGIN || true` in server/index.ts). That's
# fine for the default same-host setup above, but set this explicitly to
# your production app URL if the API is ever reachable from a different
# origin than the SPA.
ALLOWED_ORIGIN="https://your-app.up.railway.app"

# ALERT_WEBHOOK_URL: optional. Powers server/alerting.ts (Fix #8 —
# Production Observability). When set, previously-silent critical
# failures (a notification sweep's Firestore query failing, a
# background job crashing, an uncaught server error, a relayed
# client-side crash) are POSTed here as `{ "text": "..." }`, the format
# both Slack and Discord incoming webhooks accept natively — no SDK,
# no new dependency. Leaving this unset is fully safe: every one of
# those failures is still logged to stdout exactly as before (Railway
# still captures it), this just adds an external channel on top. A
# repeatedly-failing job is rate-limited to at most one alert per
# ALERT_COOLDOWN_MS (default 15 minutes) so a still-broken sweep can't
# page every single tick.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"
# ALERT_COOLDOWN_MS="900000"

# VITE_ENABLE_DEMO_TOOLS: optional, and OFF unless explicitly set to the
# literal string "true". Controls whether the Settings screen's "Carregar
# Dados de Exemplo" (load sample data) and "Limpar Todos os Dados" (delete
# essentially all of the active business's operational data — Products,
# Stock Batches, Purchase Batches, Quebras, Expenses, most Stock Counts,
# Withdrawals, Timeline Events; irreversible, no undo) buttons are shown to
# Owners in the Settings modal.
#
# You do NOT need to set this for local development — a plain `vite dev`
# server already shows these tools automatically (Vite's own built-in
# import.meta.env.DEV flag), with nothing to configure.
#
# Only set this to "true" for a deliberately-built demo/staging deployment
# that still needs these tools despite being a `vite build` output. NEVER
# set this for a real production/pilot deployment serving real business
# owners — leaving it unset is the safe, correct default; there is no
# environment where an unset or misspelled value results in these tools
# being shown.
VITE_ENABLE_DEMO_TOOLS="false"

