@@ -1 +1,41 @@
 @import "tailwindcss";
+
+/* ==========================================================================
+   SabushTech Brand Design Tokens
+   Single source of truth for the app's color system. Components should
+   reference these (directly, or via the matching Tailwind utility classes
+   they map to) instead of introducing new ad-hoc colors.
+   ========================================================================== */
+:root {
+  --background: #FFFFFF;      /* Primary background — white dominates the UI */
+  --foreground: #111111;      /* Primary text — near-black */
+
+  --primary: #EA580C;         /* Bright orange — CTAs, highlights, active states, icons */
+  --primary-hover: #C2410C;   /* Darker orange for hover on primary buttons */
+  --primary-foreground: #FFFFFF;
+
+  --secondary: #2563EB;       /* Professional blue — secondary buttons, info, links, badges */
+  --secondary-hover: #1D4ED8;
+  --secondary-foreground: #FFFFFF;
+
+  --accent: #EA580C;          /* Same as primary per spec */
+
+  --muted: #F9FAFB;           /* Light gray surface */
+  --muted-foreground: #6B7280;
+
+  --border: #E5E7EB;          /* Light gray border */
+  --ring: #EA580C;            /* Orange focus ring */
+
+  /* Status colors (kept distinct from brand chrome) */
+  --success: #059669;         /* Existing green — profit / positive states */
+  --warning: #EA580C;         /* Warning = orange per spec */
+  --info: #2563EB;            /* Info = blue per spec */
+  --error: #E11D48;           /* Existing red/rose — loss / negative states */
+}
+
+@theme {
+  --color-primary: #EA580C;
+  --color-primary-hover: #C2410C;
+  --color-secondary: #2563EB;
+  --color-secondary-hover: #1D4ED8;
+}
